# This file is an example, not automatically loaded.
# Set environment variables in your shell before starting.
PORT=3102
# Optional: database file path. Defaults to data/local/platform.sqlite
# relative to the project. An explicit relative DB_PATH uses the process cwd;
# prefer an absolute path. DB_PATH=:memory: is disposable for local QA.
# DB_PATH=C:/path/to/local/platform.sqlite
# Optional: ADMIN_TOKEN must contain at least 24 random characters.
# Admin imports stay disabled when this value is not set.
ADMIN_TOKEN=

# Hosted demo: use npm run start:hosted on Render.
# PORT and RENDER_EXTERNAL_URL are supplied by Render.
# Hosted mode forces an in-memory, source-seeded catalogue and disables imports.
# For another HTTPS host only, set PUBLIC_ORIGIN to its exact origin.
# Ordinary npm start / start-local.cmd stays loopback-only.
